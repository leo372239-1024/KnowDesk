# ===== KnowDesk 后端环境配置示例（复制为 .env 使用）=====

# 数据库
DATABASE_URL=postgresql+asyncpg://knowdesk:knowdesk@localhost:5432/knowdesk
# 同步 URL（Alembic 迁移用）
DATABASE_URL_SYNC=postgresql+psycopg://knowdesk:knowdesk@localhost:5432/knowdesk

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowdesk_chunks

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO（对象存储）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowdesk-documents
MINIO_SECURE=false

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM（OpenAI 兼容接口，DeepSeek / Ollama / vLLM 均可）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_BACKUP_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30

# Embedding / Rerank provider（fake | sentence_transformer）
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_PROVIDER=fake
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Agent 熔断
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=8192
AGENT_MAX_SECONDS=60

# 审计
AUDIT_RETENTION_DAYS=180
